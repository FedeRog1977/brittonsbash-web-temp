{
  "description": "brittonsbash Web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:styles": "run-s build:scss build:css build:css-modules build:fonts build:ts",
    "build:fonts": "cp -r ./src/components/basics/reference/fonts ./src/app/_reference",
    "build:css-modules": "mkdir -p ./src/app/reference && node ./concat-files.js \"./build/css-modules/{components,reference}/**/*.css\" --output ./src/app/_reference/styles/styles.css",
    "build:css": "postcss ./build/css --dir ./build/css-modules --base ./build/css",
    "build:scss": "sass --no-source-map ./src/components/basics:./build/css",
    "build:storybook": "tsc --noEmit && storybook build --quiet --output-dir ./dist_storybook",
    "build:ts": "tsc",
    "clean": "rimraf ./node_modules",
    "dev": "next dev",
    "dev:storybook": "storybook dev -p 6006",
    "format:check": "prettier --ignore-path ./.gitignore --check .",
    "format:fix": "prettier --ignore-path ./.gitignore --list-different --write .",
    "lint": "eslint ./src"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "7.1.0",
    "@fortawesome/free-solid-svg-icons": "7.1.0",
    "@fortawesome/react-fontawesome": "3.1.1",
    "ajv": "8.18.0",
    "ajv-errors": "3.0.0",
    "classnames": "2.3.2",
    "eslint-import-resolver-typescript": "3.5.5",
    "image-thumbnail": "1.0.17",
    "next": "15.5.12",
    "node-fetch": "3.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.55.0",
    "react-lazy-load-image-component": "1.6.3",
    "react-modal": "3.16.3",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.28.5",
    "@storybook/addon-a11y": "^10.2.18",
    "@storybook/addon-docs": "^10.2.18",
    "@storybook/addon-onboarding": "^10.2.18",
    "@storybook/react": "^10.2.18",
    "@storybook/react-webpack5": "^10.2.18",
    "@types/image-thumbnail": "1.0.4",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@types/react-lazy-load-image-component": "1.6.5",
    "@types/react-modal": "3.16.3",
    "@typescript-eslint/eslint-plugin": "5.59.8",
    "@typescript-eslint/parser": "5.59.8",
    "classnames": "2.3.2",
    "command-line-args": "5.2.1",
    "eslint": "8.41.0",
    "eslint-import-resolver-typescript": "3.5.5",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "glob": "10.5.0",
    "globals": "13.20.0",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.6",
    "postcss-cli": "10.1.0",
    "postcss-modules": "6.0.0",
    "prettier": "2.8.8",
    "rimraf": "5.0.1",
    "sass": "1.64.1",
    "storybook": "10.2.18",
    "webpack": "5.105.3",
    "@storybook/nextjs": "^10.2.18",
    "eslint-plugin-storybook": "^10.2.18"
  },
  "prettier": "./src/config/prettier/index.cjs"
}
